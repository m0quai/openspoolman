<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{F3596A78-EC0B-4F41-9AE0-88E0CFF7EC7D}</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>debug.py</StartupFile>
    <SearchPath>.</SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>OpenSpoolMan</Name>
    <RootNamespace>OpenSpoolMan</RootNamespace>
    <LaunchProvider>Standard Python launcher</LaunchProvider>
    <InterpreterId>MSBuild|.env|$(MSBuildProjectFullPath)</InterpreterId>
    <TestFramework>Pytest</TestFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="**\*.py" Exclude=".venv\**;venv\**;env\**;.env\**;__pycache__\**;data\**;logs\**;node_modules\**" />
    <Content Include="docs\**\*" />
    <Content Include="templates\**\*" />
    <Content Include="static\**\*" />
    <Content Include="compose.yaml" />
    <Content Include="requirements.txt" />
    <Content Include="Dockerfile" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="docs\" />
    <Folder Include="docs\amshelper\" />
    <Folder Include="docs\architektur\" />
    <Folder Include="docs\bambu\" />
    <Folder Include="docs\entwicklung\" />
    <Folder Include="docs\img\" />
    <Folder Include="docs\img\amshelper\" />
    <Folder Include="docs\referenz\" />
    <Folder Include="scripts\" />
    <Folder Include="static\" />
    <Folder Include="static\css\" />
    <Folder Include="static\css\fonts\" />
    <Folder Include="static\js\" />
    <Folder Include="static\prints\" />
    <Folder Include="templates\" />
    <Folder Include="templates\fragments\" />
    <Folder Include="tests\" />
  </ItemGroup>
  <ItemGroup>
    <Interpreter Include=".env\">
      <Id>.env</Id>
      <Version>3.13</Version>
      <Description>.env (Python 3.13 (64-bit))</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
</Project>